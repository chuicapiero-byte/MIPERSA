# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SECRET: Server-side secret for signing session tokens (optional; falls back to ephemeral random secret).
AUTH_SECRET=

# FILE_SIGNING_SECRET: Server-side secret for HMAC temporary image URLs (optional; falls back to server secret).
FILE_SIGNING_SECRET=

# SMTP Configuration (optional; required for sending real report emails and verification/recovery emails).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gestor de Visitas MIPERSA <notificaciones@mipersa.pe>"
